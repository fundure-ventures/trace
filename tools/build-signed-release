#!/bin/bash
set -eu

if (($# < 2 || $# > 3)); then
    echo "usage: tools/build-signed-release VERSION BUILD_NUMBER [OUTPUT_DIR]" >&2
    exit 64
fi

VERSION=$1
BUILD_NUMBER=$2
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
OUTPUT_DIR=${3:-"$ROOT/.build/release"}
BUILDER=${TRACE_RELEASE_BUILDER:-"$ROOT/tools/build-release"}
SIGNER=${TRACE_RELEASE_SIGNER:-"$ROOT/tools/sign-release"}

"$BUILDER" "$VERSION" "$BUILD_NUMBER"
"$SIGNER" "$VERSION" "$BUILD_NUMBER" "$OUTPUT_DIR"
