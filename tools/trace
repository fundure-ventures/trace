#!/bin/bash
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
CONFIGURATION=${TRACE_BUILD_CONFIGURATION:-debug}
case "$CONFIGURATION" in
    debug)
        APP_NAME="Trace Debug.app"
        PRODUCT_NAME="Trace Debug"
        BUNDLE_IDENTIFIER_SUFFIX=".debug"
        ;;
    release)
        APP_NAME="Trace.app"
        PRODUCT_NAME="Trace"
        BUNDLE_IDENTIFIER_SUFFIX=""
        ;;
    *)
        echo "error: unsupported Trace build configuration: $CONFIGURATION" >&2
        exit 64
        ;;
esac
APP="$ROOT/.build/$APP_NAME"
CONTENTS="$APP/Contents"
WEB_ROOT="$ROOT/apps/trace-macos/WebCanvas"
WEB_RESOURCES="$CONTENTS/Resources/WebCanvas"
BASE_BUNDLE_IDENTIFIER=$(
    plutil -extract CFBundleIdentifier raw -o - \
        "$ROOT/apps/trace-macos/Trace-Info.plist"
)
BUNDLE_IDENTIFIER="${BASE_BUNDLE_IDENTIFIER}${BUNDLE_IDENTIFIER_SUFFIX}"
LSREGISTER=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
CLEAR_STATE=false

show_help() {
    cat <<'EOF'
usage: ./tools/trace [--clear]

  --clear  Reset Trace onboarding, calibration, window state, and macOS
           permissions before launching. Saved .traceboard drawings remain.
EOF
}

while (($#)); do
    case "$1" in
        --clear)
            CLEAR_STATE=true
            ;;
        --help|-h)
            show_help
            exit 0
            ;;
        *)
            echo "error: unknown option: $1" >&2
            show_help >&2
            exit 64
            ;;
    esac
    shift
done

running_trace_pids() {
    ps -ax -o pid=,command= |
        awk -v executable="$CONTENTS/MacOS/trace" '
            {
                pid = $1
                sub(/^[[:space:]]*[0-9]+[[:space:]]+/, "", $0)
                if (index($0, executable) == 1) {
                    print pid
                }
            }
        '
}

registered_trace_apps() {
    "$LSREGISTER" -dump 2>/dev/null |
        awk -v bundle_id="$BUNDLE_IDENTIFIER" '
            function emit() {
                if (identifier == bundle_id && path != "") {
                    print path
                }
                path = ""
                identifier = ""
            }
            /^--------------------------------------------------------------------------------$/ {
                emit()
                next
            }
            /^path:[[:space:]]+/ {
                path = $0
                sub(/^path:[[:space:]]+/, "", path)
                sub(/[[:space:]]+\(0x[[:xdigit:]]+\)$/, "", path)
                next
            }
            /^identifier:[[:space:]]+/ {
                identifier = $0
                sub(/^identifier:[[:space:]]+/, "", identifier)
            }
            END {
                emit()
            }
        '
}

register_current_app() {
    local registered_app
    while IFS= read -r registered_app; do
        if [[ -n "$registered_app" && "$registered_app" != "$APP" ]]; then
            "$LSREGISTER" -u "$registered_app" >/dev/null 2>&1 || true
        fi
    done < <(registered_trace_apps)
    "$LSREGISTER" -f "$APP"
}

clear_trace_state() {
    local pids
    pids=$(running_trace_pids)
    if [[ -n "$pids" ]]; then
        while IFS= read -r pid; do
            if [[ "$pid" =~ ^[0-9]+$ ]]; then
                kill "$pid" 2>/dev/null || true
            fi
        done <<< "$pids"

        for ((attempt = 0; attempt < 50; attempt += 1)); do
            [[ -z "$(running_trace_pids)" ]] && break
            sleep 0.1
        done
        if [[ -n "$(running_trace_pids)" ]]; then
            echo "error: Trace is still running; quit it and retry." >&2
            exit 1
        fi
    fi

    defaults delete "$BUNDLE_IDENTIFIER" >/dev/null 2>&1 || true
    rm -rf -- \
        "${HOME:?}/Library/Application Support/Trace/InputLab/calibrations" \
        "$HOME/Library/Saved Application State/$BUNDLE_IDENTIFIER.savedState"
    tccutil reset All "$BUNDLE_IDENTIFIER"

    echo "Cleared Trace onboarding, calibrations, window state, and permissions."
    echo "Saved drawings under ~/Documents/Trace were preserved."
}

cd "$ROOT"
if $CLEAR_STATE; then
    clear_trace_state
fi

DEVELOPER_DIR=$("$ROOT/tools/resolve-xcode-developer-dir")
export DEVELOPER_DIR
SWIFT=$(xcrun --find swift)
MACOS_SDK=$("$ROOT/tools/resolve-macos-sdk")
MACOS_SDK_VERSION=$(
    plutil -extract Version raw -o - "$MACOS_SDK/SDKSettings.plist"
)
BUILD_ARGS=(
    --sdk "$MACOS_SDK"
    -c "$CONFIGURATION"
    -Xlinker -platform_version
    -Xlinker macos
    -Xlinker 13.0
    -Xlinker "$MACOS_SDK_VERSION"
)

"$SWIFT" build "${BUILD_ARGS[@]}" --product trace
BIN_DIRECTORY=$("$SWIFT" build "${BUILD_ARGS[@]}" --show-bin-path)

"$ROOT/tools/build-web-canvas" \
    "$WEB_ROOT" \
    "$ROOT/.build/web-canvas" \
    "$ROOT"

rm -rf -- "$APP"
mkdir -p "$CONTENTS/MacOS" "$CONTENTS/Resources"
cp "$BIN_DIRECTORY/trace" "$CONTENTS/MacOS/trace"
cp "$ROOT/apps/trace-macos/Trace-Info.plist" "$CONTENTS/Info.plist"
plutil -replace CFBundleDisplayName -string "$PRODUCT_NAME" "$CONTENTS/Info.plist"
plutil -replace CFBundleName -string "$PRODUCT_NAME" "$CONTENTS/Info.plist"
plutil -replace CFBundleIdentifier \
    -string "$BUNDLE_IDENTIFIER" \
    "$CONTENTS/Info.plist"
if [[ -n "${TRACE_VERSION:-}" ]]; then
    if [[ ! "$TRACE_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        echo "error: TRACE_VERSION must use MAJOR.MINOR.PATCH." >&2
        exit 64
    fi
    plutil -replace CFBundleShortVersionString \
        -string "$TRACE_VERSION" \
        "$CONTENTS/Info.plist"
fi
if [[ -n "${TRACE_BUILD_NUMBER:-}" ]]; then
    if [[ ! "$TRACE_BUILD_NUMBER" =~ ^[1-9][0-9]*$ ]]; then
        echo "error: TRACE_BUILD_NUMBER must be a positive integer." >&2
        exit 64
    fi
    plutil -replace CFBundleVersion \
        -string "$TRACE_BUILD_NUMBER" \
        "$CONTENTS/Info.plist"
fi
rm -rf "$WEB_RESOURCES"
cp -R "$WEB_ROOT/dist" "$WEB_RESOURCES"
"$ROOT/tools/copy-swiftpm-resource-bundles" \
    "$BIN_DIRECTORY" \
    "$CONTENTS/Resources"
ICON_INFO_PLIST="$ROOT/.build/trace-icon-info.plist"
xcrun actool "$ROOT/design/app-icon/trace.icon" \
    --compile "$CONTENTS/Resources" \
    --platform macosx \
    --minimum-deployment-target 13.0 \
    --app-icon trace \
    --output-partial-info-plist "$ICON_INFO_PLIST" \
    --output-format human-readable-text
/usr/libexec/PlistBuddy -c "Merge $ICON_INFO_PLIST" "$CONTENTS/Info.plist"
if [[ "${TRACE_SKIP_SIGNING:-0}" != "1" ]]; then
    "$ROOT/tools/sign-app" "$APP"
fi

if [[ "${TRACE_BUILD_ONLY:-0}" == "1" ]]; then
    exit 0
fi

"$ROOT/tools/quit-running-app" "$BUNDLE_IDENTIFIER"
register_current_app
open "$APP"
"$ROOT/tools/wait-for-running-app" "$BUNDLE_IDENTIFIER"
